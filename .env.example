# OWNER: SHARED — change only by agreement; frozen after Stage A.
# Copy to .env and fill in. Stage A runs with NO real creds — the terminal
# provider + mocked brain need nothing here.

# ---------------- Stage A: nothing required ----------------
USE_MOCKS=true                 # when true, brain returns canned values

# ---------------- Stage B: XTrace (memory) -----------------
XTRACE_API_KEY=xtk_...
XTRACE_ORG_ID=org_...

# ---------------- Stage C: RocketRide (pipeline) -----------
ROCKETRIDE_URL=http://localhost:5565
ROCKETRIDE_PIPELINE=pipelines/extract_decision.pipe

# ---------------- Stage D: Butterbase ----------------------
BUTTERBASE_PROJECT_ID=...
BUTTERBASE_API_KEY=...
BUTTERBASE_GATEWAY_URL=         # [VERIFY LIVE] OpenAI-compatible base URL
BUTTERBASE_GATEWAY_KEY=         # [VERIFY LIVE]
BUTTERBASE_GATEWAY_MODEL=       # [VERIFY LIVE] e.g. claude-...

# ---------------- Stage E: Slack (Photon Spectrum) ---------
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
SLACK_APP_TOKEN=xapp-...        # Socket Mode app-level token
SLACK_BOT_TOKEN=xoxb-...        # bot token
SLACK_CHANNEL_ID=C0123456789    # channel to watch (optional; default: all)

# ---------------- Provider switch --------------------------
# terminal | slack | imessage    (imessage = kill-switch fallback)
PROVIDER=terminal
